<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="m0609_rail_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.78 0.78 0.80 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DOOSAN ROBOTICS CABINET (Stainless top z=0.750m, M0609 mounted at front-right corner (0,0,0.750)) -->
    <model name="doosan_cabinet">
      <static>true</static>
      <pose>-0.22 0.18 0.375 0 0 0</pose>
      <link name="cabinet_link">
        <collision name="body_col"><geometry><box><size>0.62 0.72 0.75</size></box></geometry></collision>
        <visual name="body_vis">
          <pose>0 0 -0.015 0 0 0</pose>
          <geometry><box><size>0.62 0.72 0.72</size></box></geometry>
          <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
        <visual name="stainless_top">
          <pose>0 0 0.360 0 0 0</pose>
          <geometry><box><size>0.62 0.72 0.030</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
        <!-- Decorative 2x2 tape grid on cabinet top (+Y half) -->
        <visual name="cab_grid_h1"><pose>0.0 0.18 0.3755 0 0 0</pose><geometry><box><size>0.26 0.008 0.001</size></box></geometry><material><ambient>0.75 0.68 0.40 1</ambient><diffuse>0.85 0.78 0.50 1</diffuse></material></visual>
        <visual name="cab_grid_v1"><pose>0.0 0.18 0.3755 0 0 0</pose><geometry><box><size>0.008 0.26 0.001</size></box></geometry><material><ambient>0.75 0.68 0.40 1</ambient><diffuse>0.85 0.78 0.50 1</diffuse></material></visual>
      </link>
    </model>

    <!-- WOODEN BOARD TABLE: 40cm (X: 0.25..0.65) x 110cm (Y: -0.30..+0.80), top at z=0.750m -->
    <model name="wooden_board">
      <static>true</static>
      <pose>0.45 0.25 0.735 0 0 0</pose>
      <link name="board_link">
        <collision name="board_col"><geometry><box><size>0.40 1.10 0.030</size></box></geometry></collision>
        <visual name="board_vis">
          <geometry><box><size>0.40 1.10 0.030</size></box></geometry>
          <material><ambient>0.36 0.20 0.10 1</ambient><diffuse>0.52 0.30 0.15 1</diffuse><specular>0.25 0.2 0.15 1</specular></material>
        </visual>
        <!-- Aluminum support legs -->
        <visual name="leg_1"><pose>0.18 0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_2"><pose>-0.18 0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_3"><pose>0.18 -0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_4"><pose>-0.18 -0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- GREEN BELT FEEDER CONVEYOR (Joins wooden board at Y = -0.30m; Y: -0.95..-0.30m; yaw +90deg so +X TrackController moves along +Y) -->
    <model name="conveyor_feeder">
      <static>true</static>
      <pose>0.45 -0.625 0.725 0 0 1.57079632679</pose>
      <link name="conveyor_link">
        <collision name="belt_col">
          <geometry><box><size>0.65 0.40 0.050</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="belt_vis">
          <geometry><box><size>0.65 0.36 0.050</size></box></geometry>
          <material><ambient>0.04 0.16 0.09 1</ambient><diffuse>0.06 0.22 0.12 1</diffuse></material>
        </visual>
        <visual name="side_rail_l"><pose>0 0.19 0 0 0 0</pose><geometry><box><size>0.65 0.02 0.056</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="side_rail_r"><pose>0 -0.19 0 0 0 0</pose><geometry><box><size>0.65 0.02 0.056</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="drive_motor"><pose>-0.26 0 -0.065 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.16</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse></material></visual>
        <visual name="conv_leg_1"><pose>-0.28 -0.18 -0.36 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="conv_leg_2"><pose>-0.28 0.18 -0.36 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <!-- Full-width Conveyor Pick Boundary Divider (world Y = -0.495..-0.295 => local X +0.130..+0.330) -->
        <visual name="scan_front"><pose>0.330 0 0.0255 0 0 0</pose><geometry><box><size>0.010 0.36 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_back"><pose>0.130 0 0.0255 0 0 0</pose><geometry><box><size>0.012 0.36 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_left"><pose>0.230 0.175 0.0255 0 0 0</pose><geometry><box><size>0.205 0.008 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_right"><pose>0.230 -0.175 0.0255 0 0 0</pose><geometry><box><size>0.205 0.008 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
      </link>
      <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
        <link>conveyor_link</link>
        <min_velocity>-0.5</min_velocity>
        <max_velocity>0.5</max_velocity>
      </plugin>
    </model>

    <!-- 90-DEG ROTATED LINEAR RAIL AT HOME AXIS (Y = 0.0m, 30cm away from conveyor edge at Y=-0.30m) -->
    <model name="linear_rail_divider">
      <static>true</static>
      <pose>0.45 0.00 0.757 0 0 0</pose>
      <link name="rail_link">
        <collision name="rail_col"><geometry><box><size>0.40 0.045 0.014</size></box></geometry></collision>
        <visual name="rail_base">
          <geometry><box><size>0.40 0.045 0.014</size></box></geometry>
          <material><ambient>0.45 0.48 0.52 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse></material>
        </visual>
        <visual name="stepper_motor">
          <pose>0.225 0 0.012 0 0 0</pose>
          <geometry><box><size>0.048 0.048 0.048</size></box></geometry>
          <material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- YELLOW OBSTACLE PILLAR ON LINEAR RAIL (Diameter 10cm, Height 26cm -> top z_base = 0.274m) -->
    <model name="obstacle_rail_yellow">
      <static>true</static>
      <pose>0.50 0.00 0.894 0 0 0</pose>
      <link name="obs_link">
        <collision name="collision"><geometry><cylinder><radius>0.050</radius><length>0.260</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.050</radius><length>0.260</length></cylinder></geometry>
          <material><ambient>0.95 0.82 0.05 1</ambient><diffuse>1.0 0.88 0.08 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ENLARGED 2x2 SORTING TRAY (24x24cm = 12x12cm/cell at [0.45, +0.245]) WITH SQUARE & CIRCLE MARKINGS -->
    <model name="sorting_tray_2x2">
      <static>true</static>
      <pose>0.45 0.245 0.7505 0 0 0</pose>
      <link name="grid_link">
        <visual name="outer_top"><pose>-0.120 0 0 0 0 0</pose><geometry><box><size>0.006 0.246 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_bot"><pose>0.120 0 0 0 0 0</pose><geometry><box><size>0.006 0.246 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_l"><pose>0 -0.120 0 0 0 0</pose><geometry><box><size>0.246 0.006 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_r"><pose>0 0.120 0 0 0 0</pose><geometry><box><size>0.246 0.006 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="mid_x"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.005 0.240 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="mid_y"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.240 0.005 0.0015</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <!-- Square Slot 1 Marking (center X=0.390, Y=0.185 => local -0.060, -0.060; 7.2x7.2cm orange frame) -->
        <visual name="sq1_t"><pose>-0.096 -0.060 0.0005 0 0 0</pose><geometry><box><size>0.004 0.076 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq1_b"><pose>-0.024 -0.060 0.0005 0 0 0</pose><geometry><box><size>0.004 0.076 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq1_l"><pose>-0.060 -0.096 0.0005 0 0 0</pose><geometry><box><size>0.076 0.004 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq1_r"><pose>-0.060 -0.024 0.0005 0 0 0</pose><geometry><box><size>0.076 0.004 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <!-- Square Slot 2 Marking (center X=0.390, Y=0.305 => local -0.060, +0.060; 7.2x7.2cm orange frame) -->
        <visual name="sq2_t"><pose>-0.096 0.060 0.0005 0 0 0</pose><geometry><box><size>0.004 0.076 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq2_b"><pose>-0.024 0.060 0.0005 0 0 0</pose><geometry><box><size>0.004 0.076 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq2_l"><pose>-0.060 0.024 0.0005 0 0 0</pose><geometry><box><size>0.076 0.004 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <visual name="sq2_r"><pose>-0.060 0.096 0.0005 0 0 0</pose><geometry><box><size>0.076 0.004 0.0016</size></box></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>1.0 0.48 0.08 1</diffuse></material></visual>
        <!-- Circle Slot 1 Marking (center X=0.510, Y=0.185 => local +0.060, -0.060; Ø7.4cm green ring) -->
        <visual name="cir1_out"><pose>0.060 -0.060 0.0004 0 0 0</pose><geometry><cylinder><radius>0.037</radius><length>0.0012</length></cylinder></geometry><material><ambient>0.10 0.85 0.35 1</ambient><diffuse>0.15 0.92 0.42 1</diffuse></material></visual>
        <visual name="cir1_in"><pose>0.060 -0.060 0.0008 0 0 0</pose><geometry><cylinder><radius>0.031</radius><length>0.0014</length></cylinder></geometry><material><ambient>0.36 0.20 0.10 1</ambient><diffuse>0.52 0.30 0.15 1</diffuse></material></visual>
        <visual name="cir1_dot"><pose>0.060 -0.060 0.0011 0 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.0015</length></cylinder></geometry><material><ambient>0.15 0.90 0.40 1</ambient><diffuse>0.25 0.95 0.48 1</diffuse></material></visual>
        <!-- Circle Slot 2 Marking (center X=0.510, Y=0.305 => local +0.060, +0.060; Ø7.4cm green ring) -->
        <visual name="cir2_out"><pose>0.060 0.060 0.0004 0 0 0</pose><geometry><cylinder><radius>0.037</radius><length>0.0012</length></cylinder></geometry><material><ambient>0.10 0.85 0.35 1</ambient><diffuse>0.15 0.92 0.42 1</diffuse></material></visual>
        <visual name="cir2_in"><pose>0.060 0.060 0.0008 0 0 0</pose><geometry><cylinder><radius>0.031</radius><length>0.0014</length></cylinder></geometry><material><ambient>0.36 0.20 0.10 1</ambient><diffuse>0.52 0.30 0.15 1</diffuse></material></visual>
        <visual name="cir2_dot"><pose>0.060 0.060 0.0011 0 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.0015</length></cylinder></geometry><material><ambient>0.15 0.90 0.40 1</ambient><diffuse>0.25 0.95 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <!-- MANUAL FREE-DROP ZONE MARKER (Y = +0.41..+0.75m on wooden board) -->
    <model name="manual_drop_zone">
      <static>true</static>
      <pose>0.45 0.58 0.7505 0 0 0</pose>
      <link name="manual_link">
        <visual name="m_top"><pose>-0.170 0 0 0 0 0</pose><geometry><box><size>0.005 0.34 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_bot"><pose>0.170 0 0 0 0 0</pose><geometry><box><size>0.005 0.34 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_l"><pose>0 -0.17 0 0 0 0</pose><geometry><box><size>0.345 0.005 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_r"><pose>0 0.17 0 0 0 0</pose><geometry><box><size>0.345 0.005 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- WORKPIECE 1: ORANGE CUBE (6cm x 6cm x 6cm, inside conveyor pick scan zone) -->
    <model name="target_orange_cube">
      <pose>0.45 -0.38 0.781 0 0 0</pose>
      <link name="box_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.000072</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000072</iyy><iyz>0</iyz><izz>0.000072</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><bounce><restitution_coefficient>0.0</restitution_coefficient></bounce><contact><ode><kp>1000000.0</kp><kd>100.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.92 0.18 0.01 1</ambient><diffuse>1.0 0.16 0.01 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WORKPIECE 2: GREEN CYLINDER (Diameter 6cm, Height 6cm, queued on conveyor feeder) -->
    <model name="target_green_cyl">
      <pose>0.45 -0.58 0.781 0 0 0</pose>
      <link name="cyl_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.000063</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000063</iyy><iyz>0</iyz><izz>0.000054</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.030</radius><length>0.060</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><bounce><restitution_coefficient>0.0</restitution_coefficient></bounce><contact><ode><kp>1000000.0</kp><kd>100.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.030</radius><length>0.060</length></cylinder></geometry>
          <material><ambient>0.08 0.80 0.18 1</ambient><diffuse>0.12 0.94 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ALUMINUM SAFETY ENCLOSURE & OVERHEAD D435 MOUNT -->
    <model name="camera_gantry_frame">
      <static>true</static>
      <link name="frame_link">
        <visual name="post_rl"><pose>-0.56 0.86 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_rr"><pose>-0.56 -1.00 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_fl"><pose>0.86 0.86 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_fr"><pose>0.86 -1.00 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="beam_left"><pose>0.15 0.86 2.08 0 0 0</pose><geometry><box><size>1.46 0.04 0.04</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="beam_right"><pose>0.15 -1.00 2.08 0 0 0</pose><geometry><box><size>1.46 0.04 0.04</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="cross_cam"><pose>0.82 -0.07 2.08 0 0 0</pose><geometry><box><size>0.04 1.90 0.04</size></box></geometry><material><ambient>0.2 0.45 0.75 1</ambient><diffuse>0.25 0.55 0.85 1</diffuse></material></visual>
        <visual name="d435_bracket"><pose>0.82 -0.05 2.055 0 0 0</pose><geometry><box><size>0.03 0.04 0.03</size></box></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- INTEL REALSENSE D435 (Matches TF base->d435: 0.82, -0.05, 1.29, 0, 1.24, pi; full-belt + drop-zone FOV) -->
    <model name="realsense_d435">
      <static>true</static>
      <pose>0.82 -0.05 2.04 0 1.24 3.14159265</pose>
      <link name="d435_link">
        <visual name="body_visual"><pose>-0.0125 0 0 0 0 0</pose><geometry><box><size>0.025 0.090 0.025</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <visual name="front_glass"><pose>0.001 0 0 0 0 0</pose><geometry><box><size>0.002 0.084 0.020</size></box></geometry><material><ambient>0.05 0.05 0.08 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
        <sensor name="d435_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
          <topic>d435</topic><gz_frame_id>d435_color_optical_frame</gz_frame_id>
          <camera name="d435_color">
            <horizontal_fov>1.28</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.20</near><far>5.0</far></clip>
            <depth_camera><clip><near>0.20</near><far>5.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
