<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="m0609_dynamic_obstacle_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.78 0.78 0.80 1</ambient><diffuse>0.82 0.82 0.84 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- DOOSAN ROBOTICS CABINET -->
    <model name="doosan_cabinet">
      <static>true</static>
      <pose>-0.22 0.18 0.375 0 0 0</pose>
      <link name="cabinet_link">
        <collision name="body_col"><geometry><box><size>0.62 0.72 0.75</size></box></geometry></collision>
        <visual name="body_vis">
          <pose>0 0 -0.015 0 0 0</pose>
          <geometry><box><size>0.62 0.72 0.72</size></box></geometry>
          <material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.92 0.94 0.96 1</diffuse></material>
        </visual>
        <visual name="stainless_top">
          <pose>0 0 0.360 0 0 0</pose>
          <geometry><box><size>0.62 0.72 0.030</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.72 0.75 0.79 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- WOODEN BOARD TABLE: 40cm x 110cm (NO linear rail - mid zone is open for Circle/Zigzag dynamic obstacle!) -->
    <model name="wooden_board">
      <static>true</static>
      <pose>0.45 0.25 0.735 0 0 0</pose>
      <link name="board_link">
        <collision name="board_col"><geometry><box><size>0.40 1.10 0.030</size></box></geometry></collision>
        <visual name="board_vis">
          <geometry><box><size>0.40 1.10 0.030</size></box></geometry>
          <material><ambient>0.36 0.20 0.10 1</ambient><diffuse>0.52 0.30 0.15 1</diffuse><specular>0.25 0.2 0.15 1</specular></material>
        </visual>
        <visual name="leg_1"><pose>0.18 0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_2"><pose>-0.18 0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_3"><pose>0.18 -0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="leg_4"><pose>-0.18 -0.50 -0.37 0 0 0</pose><geometry><box><size>0.04 0.04 0.71</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- GREEN BELT FEEDER CONVEYOR -->
    <model name="conveyor_feeder">
      <static>true</static>
      <pose>0.45 -0.625 0.725 0 0 0</pose>
      <link name="conveyor_link">
        <collision name="belt_col">
          <geometry><box><size>0.40 0.65 0.050</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="belt_vis">
          <geometry><box><size>0.36 0.65 0.050</size></box></geometry>
          <material><ambient>0.04 0.16 0.09 1</ambient><diffuse>0.06 0.22 0.12 1</diffuse></material>
        </visual>
        <visual name="side_rail_l"><pose>-0.19 0 0 0 0 0</pose><geometry><box><size>0.02 0.65 0.056</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="side_rail_r"><pose>0.19 0 0 0 0 0</pose><geometry><box><size>0.02 0.65 0.056</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="drive_motor"><pose>0 -0.26 -0.065 0 1.5708 0</pose><geometry><cylinder><radius>0.04</radius><length>0.16</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse></material></visual>
        <visual name="conv_leg_1"><pose>0.18 -0.28 -0.36 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="conv_leg_2"><pose>-0.18 -0.28 -0.36 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry><material><ambient>0.5 0.53 0.57 1</ambient><diffuse>0.68 0.71 0.75 1</diffuse></material></visual>
        <visual name="scan_front"><pose>0 0.330 0.0255 0 0 0</pose><geometry><box><size>0.36 0.010 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_back"><pose>0 0.130 0.0255 0 0 0</pose><geometry><box><size>0.36 0.012 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_left"><pose>-0.175 0.230 0.0255 0 0 0</pose><geometry><box><size>0.008 0.205 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
        <visual name="scan_right"><pose>0.175 0.230 0.0255 0 0 0</pose><geometry><box><size>0.008 0.205 0.0015</size></box></geometry><material><ambient>0.1 0.85 1.0 1</ambient><diffuse>0.2 0.92 1.0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- DYNAMIC YELLOW OBSTACLE 1: CIRCLE MODE (Yellow Cylinder Ø10cm, H=26cm in 30cm mid zone) -->
    <model name="obstacle_circle">
      <static>true</static>
      <pose>0.54 -0.14 0.880 0 0 0</pose>
      <link name="circle_link">
        <collision name="collision"><geometry><cylinder><radius>0.050</radius><length>0.260</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.050</radius><length>0.260</length></cylinder></geometry>
          <material><ambient>0.95 0.82 0.05 1</ambient><diffuse>1.0 0.88 0.08 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- DYNAMIC YELLOW OBSTACLE 2: ZIGZAG MODE (Yellow Column ~10cm x 26cm, parked until zigzag active) -->
    <model name="obstacle_zigzag">
      <static>true</static>
      <pose>2.5 2.5 -1.0 0 0 0</pose>
      <link name="zigzag_link">
        <collision name="collision"><geometry><box><size>0.09 0.09 0.26</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.26</size></box></geometry>
          <material><ambient>0.95 0.76 0.02 1</ambient><diffuse>1.0 0.84 0.04 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- COMPACT 2x2 SORTING GRID (15x15cm) -->
    <model name="sorting_tray_2x2">
      <static>true</static>
      <pose>0.45 0.215 0.7505 0 0 0</pose>
      <link name="grid_link">
        <visual name="outer_top"><pose>-0.075 0 0 0 0 0</pose><geometry><box><size>0.005 0.155 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_bot"><pose>0.075 0 0 0 0 0</pose><geometry><box><size>0.005 0.155 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_l"><pose>0 -0.075 0 0 0 0</pose><geometry><box><size>0.155 0.005 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="outer_r"><pose>0 0.075 0 0 0 0</pose><geometry><box><size>0.155 0.005 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="mid_x"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.005 0.150 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
        <visual name="mid_y"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.150 0.005 0.001</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <!-- MANUAL FREE-DROP ZONE MARKER -->
    <model name="manual_drop_zone">
      <static>true</static>
      <pose>0.45 0.54 0.7505 0 0 0</pose>
      <link name="manual_link">
        <visual name="m_top"><pose>-0.175 0 0 0 0 0</pose><geometry><box><size>0.005 0.42 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_bot"><pose>0.175 0 0 0 0 0</pose><geometry><box><size>0.005 0.42 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_l"><pose>0 -0.21 0 0 0 0</pose><geometry><box><size>0.355 0.005 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
        <visual name="m_r"><pose>0 0.21 0 0 0 0</pose><geometry><box><size>0.355 0.005 0.001</size></box></geometry><material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.2 0.65 1.0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- WORKPIECE 1: ORANGE CUBE (6cm x 6cm x 6cm) -->
    <model name="target_orange_cube">
      <pose>0.45 -0.38 0.781 0 0 0</pose>
      <link name="box_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.000072</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000072</iyy><iyz>0</iyz><izz>0.000072</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><bounce><restitution_coefficient>0.0</restitution_coefficient></bounce><contact><ode><kp>1000000.0</kp><kd>100.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.92 0.18 0.01 1</ambient><diffuse>1.0 0.16 0.01 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WORKPIECE 2: GREEN CYLINDER (Diameter 6cm, Height 6cm) -->
    <model name="target_green_cyl">
      <pose>0.45 -0.58 0.781 0 0 0</pose>
      <link name="cyl_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.000063</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.000063</iyy><iyz>0</iyz><izz>0.000054</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.030</radius><length>0.060</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><bounce><restitution_coefficient>0.0</restitution_coefficient></bounce><contact><ode><kp>1000000.0</kp><kd>100.0</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.030</radius><length>0.060</length></cylinder></geometry>
          <material><ambient>0.08 0.80 0.18 1</ambient><diffuse>0.12 0.94 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ALUMINUM SAFETY ENCLOSURE & OVERHEAD D435 MOUNT -->
    <model name="camera_gantry_frame">
      <static>true</static>
      <link name="frame_link">
        <visual name="post_rl"><pose>-0.56 0.86 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_rr"><pose>-0.56 -1.00 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_fl"><pose>0.86 0.86 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="post_fr"><pose>0.86 -1.00 1.04 0 0 0</pose><geometry><box><size>0.04 0.04 2.08</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="beam_left"><pose>0.15 0.86 2.08 0 0 0</pose><geometry><box><size>1.46 0.04 0.04</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="beam_right"><pose>0.15 -1.00 2.08 0 0 0</pose><geometry><box><size>1.46 0.04 0.04</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.7 0.73 0.78 1</diffuse></material></visual>
        <visual name="cross_cam"><pose>0.82 -0.07 2.08 0 0 0</pose><geometry><box><size>0.04 1.90 0.04</size></box></geometry><material><ambient>0.2 0.45 0.75 1</ambient><diffuse>0.25 0.55 0.85 1</diffuse></material></visual>
        <visual name="d435_bracket"><pose>0.82 0.12 2.055 0 0 0</pose><geometry><box><size>0.03 0.04 0.03</size></box></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- INTEL REALSENSE D435 -->
    <model name="realsense_d435">
      <static>true</static>
      <pose>0.82 0.12 2.04 0 1.24 3.14159265</pose>
      <link name="d435_link">
        <visual name="body_visual"><pose>-0.0125 0 0 0 0 0</pose><geometry><box><size>0.025 0.090 0.025</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.85 0.85 0.88 1</diffuse></material></visual>
        <visual name="front_glass"><pose>0.001 0 0 0 0 0</pose><geometry><box><size>0.002 0.084 0.020</size></box></geometry><material><ambient>0.05 0.05 0.08 1</ambient><diffuse>0.1 0.1 0.12 1</diffuse></material></visual>
        <sensor name="d435_rgbd" type="rgbd_camera">
          <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
          <topic>d435</topic><gz_frame_id>d435_color_optical_frame</gz_frame_id>
          <camera name="d435_color">
            <horizontal_fov>1.20428</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.20</near><far>5.0</far></clip>
            <depth_camera><clip><near>0.20</near><far>5.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
